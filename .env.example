# Flask
SECRET_KEY=change_me_to_a_random_string
FLASK_ENV=development

# Signal worker poll interval in seconds (default: 3600 = 1 hour)
SIGNAL_POLL_INTERVAL_S=3600

# Send-to-Telegram (Analysis tab). Use the same token as your Telegram bot.
# The bot must be an admin (with "Post messages") of any channel you send to.
TELEGRAM_BOT_TOKEN=
# Optional: your personal chat ID (send /chatid to your bot to get it). Lets you
# enter your bot's own link to receive reports in your private chat with it.
TELEGRAM_CHAT_ID=

# ── Saved Reports library ─────────────────────────────────────────────────────
# Where saved reports live (default: saved_reports/ next to app.py).
# On Render, point this at a persistent disk or the library is wiped on every deploy.
REPORTS_DIR=
# Time zone for the date in report names (default America/Los_Angeles).
REPORTS_TZ=America/Los_Angeles
# Most reports the library will hold before refusing new saves (default 2000).
REPORTS_MAX=2000
# Set to any long random string to allow deleting reports from the Saved Reports
# tab (Admin → enter this token). Leave empty to turn deleting off.
REPORTS_ADMIN_TOKEN=
